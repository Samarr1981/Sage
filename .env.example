OPENAI_API_KEY=
# Vapi private (server) key — from the Vapi dashboard. Used server-side
# only: to mint/delete the temporary per-interview assistant in
# /api/realtime/start-call and /api/realtime/end-call, and to sign the
# short-lived, web-call-scoped JWT minted in /api/realtime/vapi-token
# (which the client fetches instead of using a static public key).
# Never expose this to the client.
VAPI_PRIVATE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
